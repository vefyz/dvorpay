# Локальная разработка: скопируйте в .env (не коммитьте!)
PORT=8000

# Обязательно на Railway и при первом запуске:
# Мин. 16 символов, заглавные, строчные, цифры, спецсимвол
# Пример генерации (PowerShell): -join ((33..126) | Get-Random -Count 24 | ForEach-Object {[char]$_})
SECRET_KEY=
ADMIN_LOGIN=admin
ADMIN_NAME=Администрация Двора
ADMIN_PASSWORD=

# SQLite локально:
DATABASE_URL=sqlite:///./dvorpay.db

# Railway PostgreSQL (добавьте плагин Postgres — переменная подставится автоматически):
# DATABASE_URL=${{Postgres.DATABASE_URL}}
